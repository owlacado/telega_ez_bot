# Local development only. No provider credentials are needed.
POSTGRES_USER=hub
POSTGRES_PASSWORD=hub_local_only
POSTGRES_DB=technician_hub
POSTGRES_PORT=5436
API_PORT=8000
WEB_PORT=3000
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://hub:hub_local_only@127.0.0.1:5436/technician_hub
API_INTERNAL_URL=http://127.0.0.1:8000

# Secure cookies are mandatory with HTTPS; this exception is loopback development only.
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
TELEGRAM_MODE=disabled
TELEGRAM_EXPECTED_BOT_ID=
TELEGRAM_EXPECTED_BOT_USERNAME=
# New invitations connect automatically; lifetime is enforced server-side (60-3600 seconds).
TELEGRAM_INVITE_SECONDS=900
# Later dedicated TEST bot only: store token in .local/telegram-bot-token.txt.
# Native worker may set TELEGRAM_TOKEN_FILE to that absolute file path.

# Optional native-worker-only alternative: TELEGRAM_BOT_TOKEN (secret; no value in this file).
# Keep privacy mode on. New group onboarding needs membership/send permission, not admin rights.

# Stage 2: disabled until explicitly configured with a dedicated TEST Google account.
GOOGLE_MODE=disabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Generate a Fernet key server-side; never commit it or prefix it NEXT_PUBLIC_.
GOOGLE_CALENDAR_CREDENTIAL_ENCRYPTION_KEY=
