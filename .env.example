# REQUIRED CORE (safe loopback development values; replace sample credentials in production)
POSTGRES_USER=hub
POSTGRES_PASSWORD=hub_local_only
POSTGRES_DB=technician_hub
POSTGRES_PORT=5436
DATABASE_URL=postgresql+asyncpg://hub:hub_local_only@127.0.0.1:5436/technician_hub
APP_ENV=development
DEBUG=false
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
APP_VERSION=0.3.0
# Production requires the exact lowercase 40-character release commit.
RELEASE_COMMIT=development

# REQUIRED WEB / LOCAL PORTS
API_INTERNAL_URL=http://127.0.0.1:8000
API_PORT=8000
WEB_PORT=3000

# OPTIONAL CORE
SESSION_LIFETIME_SECONDS=28800
WORK_REPORT_SESSION_SECONDS=900

# REQUIRED TELEGRAM only when TELEGRAM_MODE=real
TELEGRAM_MODE=disabled
TELEGRAM_EXPECTED_BOT_ID=
TELEGRAM_EXPECTED_BOT_USERNAME=
TELEGRAM_INVITE_SECONDS=900
# Choose one server-only token source. Compose mounts a private file for its workers.
TELEGRAM_TOKEN_FILE=
TELEGRAM_BOT_TOKEN=

# REQUIRED GOOGLE CALENDAR and GOOGLE SHEETS only when GOOGLE_MODE=real
# Sheets uses the same OAuth client and encryption key; its narrow scope is requested explicitly.
GOOGLE_MODE=disabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Fernet key stored outside Git, screenshots, prompts, and database backups.
GOOGLE_CALENDAR_CREDENTIAL_ENCRYPTION_KEY=

# REQUIRED SCHEDULE DELIVERY only when SCHEDULE_DELIVERY_ENABLED=true
SCHEDULE_DELIVERY_ENABLED=false
SCHEDULE_PAYLOAD_ENCRYPTION_KEY=
SCHEDULE_AUTO_DELIVERY_LOCAL_TIME=20:00

# TEST-ONLY; keep these out of production configuration.
TEST_DATABASE_URL=postgresql+asyncpg://hub:hub_test_only@127.0.0.1:5437/technician_hub_test
E2E_BASE_URL=

# No deprecated or unknown runtime variables are intentionally supported.
